{
  "name": "mdpreview",
  "version": "2.0.4",
  "private": true,
  "description": "Offline macOS Markdown viewer and editor",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "test": "node scripts/test-js.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "docx": "9.15.3",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "katex": "0.19.1",
    "marked": "12.0.0",
    "marked-footnote": "1.4.0",
    "mermaid": "11.17.2",
    "turndown": "7.2.5"
  }
}
